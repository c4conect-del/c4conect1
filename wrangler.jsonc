{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "c4conect1",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "dist/server/index.mjs",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "c4conect1-catalog",
      "database_id": "5747db59-51b9-43df-a7cc-1b1325318a1f",
      "migrations_dir": "migrations"
    }
  ],
  "account_id": "7ec999341c00c1cfdc7e1801a7dbc9b6",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "c4imports.com/*",
      "zone_id": "3edbef57b32496d6dfc5ccb9414fd400"
    },
    {
      "pattern": "www.c4imports.com/*",
      "zone_id": "3edbef57b32496d6dfc5ccb9414fd400"
    }
  ]
}
